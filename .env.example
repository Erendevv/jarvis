# Bu dosyayı .env olarak kopyala ve doldur.
#   Copy-Item .env.example .env
# .env dosyası .gitignore'da; asla commit etme.

# --- Aşama 1: Ses ---

# Uyandırma motoru: openwakeword veya porcupine
#   openwakeword : açık kaynak, kayıt/anahtar YOK. Varsayılan.
#   porcupine    : Picovoice. Daha az yanlış tetikleme ama AccessKey ister.
WAKE_ENGINE=openwakeword

# Uyandırma kelimesi. Boş bırakırsan motorun varsayılanı kullanılır
# (openwakeword -> hey_jarvis, porcupine -> jarvis).
#   openwakeword seçenekleri: hey_jarvis, alexa, hey_mycroft, hey_rhasspy,
#                             timer, weather
#   porcupine seçenekleri:    jarvis, computer, alexa, hey siri, hey google,
#                             terminator, picovoice, porcupine, bumblebee, ...
WAKE_WORD=

# 0.0 - 1.0 arası. Yüksek = daha kolay tetiklenir ama yanlış tetikleme artar.
WAKE_SENSITIVITY=0.6

# Konuşma algılama motoru: silero, cobra veya rms
#   silero : openWakeWord ile gelir, anahtar YOK. Varsayılan.
#   cobra  : Picovoice, AccessKey ister.
#   rms    : basit enerji eşiği, son çare.
VAD_ENGINE=silero

# Yalnızca WAKE_ENGINE=porcupine veya VAD_ENGINE=cobra kullanıyorsan gerekli.
# Varsayılan kurulumda boş kalabilir. Ücretsiz al: https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=

# Mikrofon cihaz indeksi. Boş bırakırsan varsayılan mikrofon kullanılır.
# Listeyi görmek için: python -m jarvis.selftest
AUDIO_INPUT_DEVICE=

# --- STT (faster-whisper) ---
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=tr

# --- VAD (konuşma bitiş algılama) ---
# Bu olasılığın üstü "konuşuyor" sayılır. Ölçümde konuşma kareleri 0.3-0.8,
# sessizlik/gürültü 0.02'nin altında kaldı; 0.25 ikisini net ayırıyor.
VAD_THRESHOLD=0.25
# Bu kadar milisaniye sessizlikten sonra kayıt biter.
VAD_SILENCE_MS=900
# Wake word sonrası konuşma başlaması için bekleme (ms). Aşılırsa iptal.
VAD_START_TIMEOUT_MS=6000
# Tek komutun maksimum uzunluğu (ms).
VAD_MAX_UTTERANCE_MS=30000

# Yanıttan sonra "Hey Jarvis" demeden konuşmaya devam edebileceğin süre.
# 0 yaparsan her komut için uyandırma kelimesi gerekir.
FOLLOWUP_WINDOW_MS=7000
# Jarvis sana soru sorduysa bu kadar bekler (yanıt bekliyor demektir).
FOLLOWUP_QUESTION_MS=15000

# --- TTS ---
# edge (çevrimiçi, doğal) veya sapi (çevrimdışı, Windows yerleşik)
TTS_ENGINE=edge
TTS_VOICE=tr-TR-AhmetNeural

# --- HUD (web arayüzü) ---
HUD_ENABLED=true
# Sadece bu makineden erişilir. 0.0.0.0 yapma; ağdaki herkese açılır.
HUD_HOST=127.0.0.1
HUD_PORT=8765

# --- Güvenlik ---
# Hangi risk seviyesinden itibaren onay sorulsun?
#   medium   : dosya/uygulama açma, yazma ve üzeri sorulur (en sıkı)
#   high     : kabuk komutu, pencere kapatma ve üzeri sorulur
#   critical : yalnızca geri dönüşü olmayan işlemler sorulur
#              (mail gönderme, kalıcı silme, ödeme, rm -rf, DROP TABLE)
#   none     : hiçbir şey sorulmaz
# Hangi seviyede olursan ol, HER eylem logs/ altına yazılır.
APPROVAL_LEVEL=medium

# Seviyeden bağımsız istisnalar. Araç adlarını virgülle ayır.
# Örnek: ALWAYS_ALLOW=mcp__desktop__open_path,mcp__desktop__open_app
ALWAYS_ALLOW=
# Örnek: ALWAYS_ASK=Bash,PowerShell
ALWAYS_ASK=
# Onay istendiğinde kaç saniye beklenir. Süre dolarsa REDDEDİLİR.
APPROVAL_TIMEOUT_SEC=60

# --- Beyin (Claude Code) ---
# Boş bırakırsan Claude Code'un varsayılan modeli kullanılır.
CLAUDE_MODEL=
# Tek komut için azami araç turu (sonsuz döngü emniyeti).
CLAUDE_MAX_TURNS=25
# Tek komuta ayrılan azami süre (saniye).
CLAUDE_TIMEOUT_SEC=300

# --- Aşama 3+ (şimdilik boş kalabilir) ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
